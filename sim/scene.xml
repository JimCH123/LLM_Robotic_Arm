            <geom type="box" size="0.04 0.003 0.015" pos="0 0.037 0.015" rgba="0.6 0.6 0.6 1"/>
            <geom type="box" size="0.04 0.003 0.015" pos="0 -0.037 0.015" rgba="0.6 0.6 0.6 1"/>
            <geom type="box" size="0.003 0.04 0.015" pos="0.037 0 0.015" rgba="0.6 0.6 0.6 1"/>
